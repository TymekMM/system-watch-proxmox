{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0-draft.2"
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "collector_version": {
          "type": "string",
          "minLength": 1
        },
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "hostname",
        "generated_at",
        "collector_version",
        "instance_id",
        "sequence"
      ],
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "properties": {
        "uptime_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "load_averages": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "uptime_seconds",
        "load_averages"
      ],
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "properties": {
        "system": {
          "$ref": "#/$defs/summary"
        },
        "system_policy": {
          "const": "legacy-v3-temperature-scope"
        },
        "zfs": {
          "$ref": "#/$defs/summary"
        },
        "hottest_temperature_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "system",
        "system_policy",
        "zfs",
        "hottest_temperature_id"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "temperatures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/temperature"
      }
    },
    "fans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fan"
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "zfs": {
      "type": "object",
      "properties": {
        "inventory_state": {
          "enum": [
            "ok",
            "error",
            "unavailable"
          ]
        },
        "pool_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "pools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pool"
          }
        }
      },
      "required": [
        "inventory_state",
        "pool_count",
        "pools"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "snapshot",
    "system",
    "health",
    "sources",
    "temperatures",
    "fans",
    "devices",
    "zfs"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System-Watch snapshot 1.0.0-draft.1",
  "$defs": {
    "reading": {
      "type": "object",
      "properties": {
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "age_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "stale_after_seconds": {
          "type": "number",
          "minimum": 0
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "unavailable"
          ]
        },
        "last_attempt_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_attempt_status": {
          "enum": [
            "ok",
            "error",
            "skipped",
            "never"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "observed_at",
        "age_seconds",
        "stale_after_seconds",
        "freshness",
        "last_attempt_at",
        "last_attempt_status",
        "reason"
      ],
      "additionalProperties": false
    },
    "errors": {
      "type": "object",
      "properties": {
        "read": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "write": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "checksum": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "read",
        "write",
        "checksum"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "ok",
            "warning",
            "critical",
            "unknown"
          ]
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "state",
        "coverage",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ipmi",
            "hwmon",
            "perccli",
            "smart",
            "zfs",
            "system",
            "inventory"
