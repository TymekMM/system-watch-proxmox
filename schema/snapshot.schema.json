        },
        "refresh_seconds": {
          "type": "number",
          "minimum": 0
        },
        "state": {
          "enum": [
            "ok",
            "partial",
            "error",
            "unavailable"
          ]
        },
        "last_attempt_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_success_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "refresh_seconds",
        "state",
        "last_attempt_at",
        "last_success_at",
        "duration_ms",
        "error"
      ],
      "additionalProperties": false
    },
    "temperature": {
